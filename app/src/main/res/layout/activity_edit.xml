<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/new_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <TextView
                style="@style/Label"
                android:layout_marginTop="8dp"
                android:text="@string/label_task" />

            <EditText
                android:id="@+id/input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input"
                android:gravity="top|start"
                android:hint="@string/task_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="2"
                android:padding="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="17sp" />

            <TextView
                style="@style/Label"
                android:text="@string/label_time" />

            <Button
                android:id="@+id/time"
                style="@style/Field"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Label"
                android:text="@string/label_repeat" />

            <RadioGroup
                android:id="@+id/repeat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/repeatOnce"
                    style="@style/Radio"
                    android:text="@string/repeat_once" />

                <RadioButton
                    android:id="@+id/repeatDaily"
                    style="@style/Radio"
                    android:text="@string/repeat_daily" />

                <RadioButton
                    android:id="@+id/repeatDays"
                    style="@style/Radio"
                    android:text="@string/repeat_days" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/dateRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Label"
                    android:text="@string/label_date" />

                <Button
                    android:id="@+id/date"
                    style="@style/Field" />
            </LinearLayout>

            <TextView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/preview_bg"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/save"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/btn_primary"
                android:stateListAnimator="@null"
                android:text="@string/save"
                android:textAllCaps="false"
                android:textColor="@color/on_accent"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/test"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_outline"
                android:stateListAnimator="@null"
                android:text="@string/test_call"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="16sp" />

            <Button
                android:id="@+id/delete"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:stateListAnimator="@null"
                android:text="@string/delete"
                android:textAllCaps="false"
                android:textColor="@color/danger"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
